---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import type { Props as IconProps } from './Icon.astro';
import { site, links } from '../data/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

type Item = {
  label: string;
  hint?: string;
  icon: IconProps['name'];
  href?: string;
  action?: string;
  external?: boolean;
  keywords?: string;
};

const groups: { title: string; items: Item[] }[] = [
  {
    title: 'Navigate',
    items: [
      { label: 'Home', icon: 'hash', href: '/#top' },
      { label: 'How I work', hint: 'Lead · Architect · Deploy', icon: 'hash', href: '/#modes', keywords: 'em staff fde' },
      { label: 'Selected work', icon: 'hash', href: '/#work', keywords: 'projects case studies' },
      { label: 'Experience', icon: 'hash', href: '/#experience', keywords: 'career timeline jobs' },
      { label: 'Stack', icon: 'hash', href: '/#stack', keywords: 'skills tools' },
      { label: 'Open source', icon: 'hash', href: '/#open-source', keywords: 'github' },
      { label: 'About', icon: 'hash', href: '/#about', keywords: 'personal manga cooking education' },
      { label: 'Contact', icon: 'hash', href: '/#contact' },
    ],
  },
  {
    title: 'Case studies',
    items: work.map((w) => ({
      label: w.data.title,
      hint: w.data.company,
      icon: 'layers' as const,
      href: `/work/${w.id}/`,
      keywords: w.data.tags.join(' '),
    })),
  },
  {
    title: 'Actions',
    items: [
      { label: 'Copy email address', hint: site.email, icon: 'copy', action: 'copy-email' },
      { label: 'Download résumé', hint: 'PDF', icon: 'download', href: site.resume, action: 'download', keywords: 'cv resume' },
      { label: 'Toggle light / dark', icon: 'sun', action: 'theme', keywords: 'theme mode' },
      { label: 'LinkedIn', icon: 'linkedin', href: links.linkedin, external: true },
      { label: 'GitHub', icon: 'github', href: links.github, external: true },
      { label: 'Send an email', icon: 'mail', href: links.email },
    ],
  },
];
---

<dialog class="palette" data-palette aria-label="Command menu">
  <div class="palette-box">
    <div class="palette-search">
      <Icon name="search" size={18} />
      <input
        type="text"
        placeholder="Search sections, case studies, actions…"
        aria-label="Search"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
      />
      <kbd>esc</kbd>
    </div>
    <div class="palette-list" id="palette-list" role="listbox" data-palette-list>
      {
        groups.map((g) => (
          <div class="group" data-group>
            <p class="group-title mono">{g.title}</p>
            {g.items.map((item) => (
              <a
                class="item"
                role="option"
                href={item.href ?? '#'}
                data-item
                data-action={item.action}
                data-search={`${item.label} ${item.hint ?? ''} ${item.keywords ?? ''}`.toLowerCase()}
                {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
                {...(item.action === 'download' ? { download: '' } : {})}
              >
                <Icon name={item.icon} size={16} />
                <span class="label">{item.label}</span>
                {item.hint && <span class="hint">{item.hint}</span>}
                {item.external && <Icon name="arrowUpRight" size={14} class="ext" />}
              </a>
            ))}
          </div>
        ))
      }
      <p class="empty" data-palette-empty hidden>No matches. Try “agentic”, “résumé” or “contact”.</p>
    </div>
    <div class="palette-foot mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span class="toast" data-palette-toast aria-live="polite"></span>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
  const items = [...dialog.querySelectorAll<HTMLAnchorElement>('[data-item]')];
  const groups = [...dialog.querySelectorAll<HTMLElement>('[data-group]')];
  const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
  const toast = dialog.querySelector<HTMLElement>('[data-palette-toast]')!;
  let active = 0;

  const visible = () => items.filter((i) => !i.hidden);

  function setActive(index: number) {
    const list = visible();
    if (!list.length) return;
    active = (index + list.length) % list.length;
    list.forEach((el, i) => el.setAttribute('aria-selected', String(i === active)));
    list[active].scrollIntoView({ block: 'nearest' });
  }

  // Every word typed must appear somewhere: "agent snow" finds the agentic case study.
  function filter() {
    const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    items.forEach((el) => {
      const s = el.dataset.search ?? '';
      el.hidden = !words.every((w) => s.includes(w));
    });
    groups.forEach((g) => (g.hidden = !g.querySelector('[data-item]:not([hidden])')));
    empty.hidden = visible().length > 0;
    setActive(0);
  }

  function open() {
    if (dialog.open) return;
    input.value = '';
    toast.textContent = '';
    filter();
    dialog.showModal();
    input.focus();
  }

  function close() {
    dialog.close();
  }

  async function run(el: HTMLAnchorElement, e?: Event) {
    const action = el.dataset.action;
    if (action === 'copy-email') {
      e?.preventDefault();
      const email = document.body.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        toast.textContent = 'Email copied ✓';
      } catch {
        window.location.href = `mailto:${email}`;
      }
      return;
    }
    if (action === 'theme') {
      e?.preventDefault();
      document.dispatchEvent(new CustomEvent('toggle-theme'));
      return;
    }
    if (!e) el.click();
    close();
  }

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) && !dialog.contains(target);
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    } else if (e.key === '/' && !typing && !dialog.open) {
      e.preventDefault();
      open();
    }
  });

  document.querySelectorAll('[data-palette-open]').forEach((b) => b.addEventListener('click', open));

  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const el = visible()[active];
      if (el) run(el);
    }
  });

  items.forEach((el) => {
    el.addEventListener('click', (e) => run(el, e));
    el.addEventListener('mousemove', () => setActive(visible().indexOf(el)));
  });

  // Don't leave focus parked in the closed dialog (it would swallow the "/" shortcut).
  dialog.addEventListener('close', () => input.blur());

  // Click on the backdrop closes.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });

  // Show the right modifier key.
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('[data-mod-key]').forEach((k) => (k.textContent = '⌘K'));
  }
</script>

<style>
  .palette {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100dvh - 120px));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-2) 92%, transparent);
    color: var(--text);
    box-shadow: var(--shadow), 0 0 0 1px rgba(0 0 0 / 0.2), 0 0 80px -30px var(--glow);
    backdrop-filter: blur(20px);
    overflow: hidden;
  }
  .palette[open] {
    animation: pop 0.22s var(--ease);
  }
  .palette::backdrop {
    background: rgba(2 4 8 / 0.6);
    backdrop-filter: blur(4px);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
  .palette-box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .palette-search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  .palette-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: 1rem var(--font-sans);
  }
  .palette-list {
    overflow-y: auto;
    padding: 8px;
    overscroll-behavior: contain;
  }
  .group + .group {
    margin-top: 6px;
  }
  .group-title {
    padding: 10px 12px 6px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.68rem;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-2);
    font-size: 0.94rem;
    outline: none;
  }
  .item[aria-selected='true'] {
    background: var(--accent-soft);
    color: var(--text);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .item[aria-selected='true'] > :global(svg:first-child) {
    color: var(--accent);
  }
  .label {
    flex: none;
  }
  .hint {
    margin-left: auto;
    color: var(--muted);
    font: 0.78rem var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .item :global(.ext) {
    margin-left: auto;
    color: var(--muted);
  }
  .empty {
    padding: 24px 12px;
    text-align: center;
    color: var(--muted);
  }
  .palette-foot {
    display: flex;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.72rem;
  }
  .palette-foot kbd {
    margin-right: 3px;
  }
  .toast {
    margin-left: auto;
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .hint {
      display: none;
    }
    .palette {
      margin-top: 72px;
    }
  }
</style>
