---
import SectionHead from './SectionHead.astro';
import { stack } from '../data/profile';
---

<section class="section" id="stack" aria-labelledby="stack-title">
  <div class="container">
    <SectionHead
      id="stack-title"
      eyebrow="Stack"
      title="Full-stack AI, layer by layer."
      lede="Comfortable at every layer — from the agent a user talks to, down to the compute it runs on, and the team that keeps it running."
    />
    <div class="stack panel">
      {
        stack.map((row, i) => (
          <div class="layer" data-reveal style={`--delay: ${i * 60}ms`}>
            <div class="layer-name">
              <span class="mono idx">L{stack.length - i}</span>
              <h3>{row.layer}</h3>
            </div>
            <ul class="chips">
              {row.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack {
    overflow: hidden;
  }
  .layer {
    position: relative;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    padding: 22px 28px;
    border-top: 1px solid var(--border);
    transition: background 0.3s;
  }
  .layer:first-child {
    border-top: 0;
  }
  .layer::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--accent), var(--accent-2));
    transform: scaleY(0);
    transition: transform 0.35s var(--ease);
  }
  .layer:hover {
    background: var(--surface-2);
  }
  .layer:hover::before {
    transform: scaleY(1);
  }
  .layer:hover .chip {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .layer-name {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .idx {
    color: var(--accent);
  }
  h3 {
    font-size: 1.08rem;
    letter-spacing: -0.01em;
  }
  .chip {
    transition: border-color 0.3s, color 0.3s;
  }
  @media (max-width: 760px) {
    .layer {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 20px;
    }
  }
</style>
