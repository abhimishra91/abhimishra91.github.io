---
// "A" drawn as a tiny node graph — initials meet agent graph.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--accent)" />
      <stop offset="1" stop-color="var(--accent-2)" />
    </linearGradient>
  </defs>
  <rect x="0.75" y="0.75" width="30.5" height="30.5" rx="9" fill="var(--surface-2)" stroke={`url(#${id})`} stroke-width="1.5"></rect>
  <path d="M9 23 16 8.5 23 23M11.6 17.6h8.8" fill="none" stroke={`url(#${id})`} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
  <circle cx="16" cy="8.5" r="2.3" fill="var(--accent)"></circle>
  <circle cx="9" cy="23" r="2.3" fill={`url(#${id})`}></circle>
  <circle cx="23" cy="23" r="2.3" fill="var(--accent-2)"></circle>
</svg>
